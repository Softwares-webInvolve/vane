{
  "name": "@webinvolve/vane",
  "version": "0.0.0",
  "description": "A scroll-aware React navbar that shows the section you're reading and never breaks keyboard focus.",
  "type": "module",
  "license": "MIT",
  "author": "Jasim Muzamil <webinvolve@webinvolve.com>",
  "engines": {
    "node": ">=18.18.0"
  },
  "homepage": "https://github.com/Softwares-webInvolve/vane#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Softwares-webInvolve/vane.git",
    "directory": "packages/vane"
  },
  "bugs": {
    "url": "https://github.com/Softwares-webInvolve/vane/issues"
  },
  "keywords": [
    "navbar",
    "scrollspy",
    "scroll-spy",
    "sticky-nav",
    "sticky-header",
    "hide-on-scroll",
    "headroom",
    "scroll-direction",
    "active-section",
    "table-of-contents",
    "react",
    "accessibility",
    "a11y",
    "wcag",
    "intersection-observer",
    "scroll-driven-animations"
  ],
  "sideEffects": [
    "*.css"
  ],
  "files": [
    "dist"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./headless": {
      "import": {
        "types": "./dist/headless.d.mts",
        "default": "./dist/headless.mjs"
      },
      "require": {
        "types": "./dist/headless.d.cts",
        "default": "./dist/headless.cjs"
      }
    },
    "./styles.css": "./dist/styles.css",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "bunchee && cp src/styles/vane.css dist/styles.css",
    "dev": "bunchee --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "eslint ."
  },
  "peerDependencies": {
    "react": "^18.2.0 || ^19.0.0",
    "@types/react": "*"
  },
  "peerDependenciesMeta": {
    "@types/react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@size-limit/preset-small-lib": "^14.0.0",
    "@types/node": "^22.10.5",
    "@types/react": "^19.0.2",
    "bunchee": "^7.0.1",
    "publint": "^0.3.24",
    "react": "^19.0.0",
    "size-limit": "^14.0.0",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  },
  "size-limit": [
    {
      "name": "main entry (incl. CSS)",
      "path": [
        "dist/index.mjs",
        "dist/styles.css"
      ],
      "gzip": true,
      "disablePlugins": [
        "@size-limit/rolldown"
      ],
      "limit": "4.0 kB"
    },
    {
      "name": "headless",
      "path": "dist/headless.mjs",
      "gzip": true,
      "limit": "2.2 kB"
    }
  ]
}
